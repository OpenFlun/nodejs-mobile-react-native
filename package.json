{
  "name": "@flun/nodejs-mobile-react-native",
  "version": "1.0.0",
  "description": "Node.js for Mobile Apps React Native plugin (flun fork, based on nodejs-mobile-react-native 18.20.4)",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "postinstall": "node scripts/create-node-structure.js && node scripts/download-prebuilt-assets.js"
  },
  "keywords": [
    "react-native",
    "mobile",
    "nodejs",
    "node.js",
    "nodejs-mobile"
  ],
  "author": "flun",
  "license": "MIT",
  "homepage": "https://github.com/OpenFlun/nodejs-mobile-react-native",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenFlun/nodejs-mobile-react-native"
  },
  "bugs": {
    "url": "https://github.com/OpenFlun/nodejs-mobile-react-native/issues"
  },
  "peerDependencies": {
    "react-native": ">=0.60.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "dependencies": {
    "mkdirp": "^3.0.1",
    "ncp": "^2.0.0",
    "node-gyp-build-mobile": "4.6.0-3",
    "@flun/nodejs-mobile-gyp": "^1.0.1",
    "adm-zip": "^0.6.1"
  },
  "type": "module",
  "files": [
    "index.js",
    "native.js",
    "index.d.ts",
    "types.d.ts",
    "react-native.config.js",
    "nodejs-mobile-react-native.podspec",
    "android/",
    "!android/libnode/",
    "!android/.cxx/",
    "!android/build/",
    "!android/app/build/",
    "!android/.gradle/",
    "!android/.kotlin/",
    "!android/local.properties",
    "ios/",
    "!ios/Pods/",
    "!ios/build/",
    "!ios/DerivedData/",
    "!ios/.symlinks/",
    "!ios/**/xcuserdata/",
    "!ios/NodeMobile.xcframework/",
    "install/",
    "scripts/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "prebuiltAssets": {
    "version": "v18.20.4",
    "sources": [
      "https://gitee.com/OpenFlun/nodejs-mobile/releases/download",
      "https://github.com/OpenFlun/nodejs-mobile/releases/download"
    ],
    "assets": [
      {
        "file": "android-libnode.zip",
        "entry": "libnode",
        "target": "android/libnode",
        "platforms": [
          "win32",
          "darwin",
          "linux"
        ],
        "envKey": "ANDROID"
      },
      {
        "file": "ios-nodemobile.zip",
        "entry": "NodeMobile.xcframework",
        "target": "ios/NodeMobile.xcframework",
        "platforms": [
          "darwin"
        ],
        "envKey": "IOS",
        "hintOn": "darwin",
        "hint": "检测到 macOS，将一并下载 iOS 附件（约 47 MB）。若只做 Android 编译，可设置环境变量 NODE_MOBILE_PREBUILT_IOS_SKIP=1 跳过。"
      }
    ]
  },
  "module": "./index.js",
  "exports": {
    ".": "./index.js"
  }
}